//Student Object
let student = {
    name: "Ann",
    age: 16,
    scores: [85, 92, 74, 60],
    class: "JHS 1B",
};

console.log(student);

//For loop
let totalScores = 0;
let averageScore = 0;

for (let i = 0; i < student.scores.length; i++){
    totalScores = totalScores + student.scores[i];
    averageScore = totalScores / student.scores.length;
}

console.log("The total score is", totalScores);
console.log("The average score is", averageScore);


//If condition

if (averageScore >= 90){
    console.log("grade A");
}
else if (averageScore >= 80){
    console.log("grade B");
}
else if (averageScore >= 70){
    console.log("grade C");
}
else if (averageScore >= 60){
    console.log("grade D");
}
else {
    console.log("grade F");
}


